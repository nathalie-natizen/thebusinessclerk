# Copy these into Vercel → Project → Settings → Environment Variables. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://app.thebusinessclerk.com

# Stripe (Dashboard → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (Dashboard → Product catalog)
STRIPE_PRICE_RA=            # Registered agent $49/year (recurring)
STRIPE_PRICE_MAIL=          # Business address & mail $20/month (recurring)
STRIPE_PRICE_LLC=           # Florida LLC formation $213 (one time)
STRIPE_PRICE_CORP=          # Florida corporation formation $158 (one time)
STRIPE_PRICE_ANNUAL_REPORT= # Annual report filing $100 (one time)
STRIPE_PRICE_EIN=           # EIN application $75 (one time)
STRIPE_PRICE_LAUNCH=        # Launch Pack $350 (one time)

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=         # e.g. +14075550123 (registered for A2P 10DLC or toll-free verified)

# Email notifications (Resend.com)
RESEND_API_KEY=
EMAIL_FROM=The Business Clerk <hello@thebusinessclerk.com>

# EasyPost (carrier tracking for forwarded mail: USPS, UPS, FedEx, DHL)
EASYPOST_API_KEY=
# Webhook URL to add in EasyPost: https://app.thebusinessclerk.com/api/tracking/webhook
